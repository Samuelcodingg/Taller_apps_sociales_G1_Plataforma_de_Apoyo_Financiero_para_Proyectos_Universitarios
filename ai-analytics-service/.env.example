# Conexión a MariaDB (mismo formato que el resto del monorepo)
DATABASE_URL=mysql://app_user:app_password@localhost:3306/app_db

# Clave de la API de Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Feed personalizado: cuántas campañas se recomiendan por donante y cuántas
# candidatas se le muestran al LLM en cada ranking.
FEED_TOP_N=9
FEED_CANDIDATE_LIMIT=60
